{
  "name": "@switchback/desktop",
  "productName": "Switchback",
  "switchback": {
    "_updateFeed": "发布时填一个 https 地址，返回 {version,url,notes}。留空 = 更新检查整个关闭，不发任何请求。",
    "updateFeed": ""
  },
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Switchback 桌面端：Electron 壳 + React 渲染层",
  "author": "wzj",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test:smoke": "node ../../scripts/e2e-smoke.mjs",
    "preview": "electron-vite preview",
    "//dist": "默认**关掉钥匙串自动发现**。不关的话 electron-builder 会拿钥匙串里任何一张证书去签——本机那张自签的会让 codesign 卡在逐个文件签名上（实测卡死，要手动 kill）。要签名走 dist:signed。",
    "dist": "node ../../scripts/dist.mjs full",
    "dist:thin": "node ../../scripts/dist.mjs thin",
    "dist:all": "node ../../scripts/dist.mjs all",
    "//dist:signed": "有 Developer ID 时用。需要 CSC_NAME 或 CSC_LINK，公证还要 APPLE_ID / APPLE_APP_SPECIFIC_PASSWORD / APPLE_TEAM_ID。",
    "dist:signed": "node ../../scripts/dist.mjs full --signed",
    "//dist:local": "只出 release/mac-arm64/Switchback.app，不打 DMG——本机自更新（应用里那颗「更新到最新代码」）跑的就是这条。DMG 那 208 MB 是给别人装的，自己换一份包用不着，省下的是大头。",
    "dist:local": "node ../../scripts/dist.mjs full --dir"
  },
  "//optionalDependencies": [
    "Claude Agent SDK 各平台的原生二进制。**必须在这里显式列出**——",
    "它们是 SDK 自己的 optionalDependencies，而 pnpm 10+ 不会替别的平台装传递依赖。",
    "实测在 macOS 上打 Linux 包时 electron-builder 直接警告它们没被打进产物，",
    "也就是说那个包里的 Claude 引擎根本起不来。",
    "每个包都带 os/cpu 字段，所以本机只会装 darwin-arm64 那一个，不占地方；",
    "Linux / Windows 的产物必须在对应平台上打，才装得到对应的那个。"
  ],
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.231",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.231",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.231",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.231",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.231",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.231"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.231",
    "@switchback/engine": "workspace:*",
    "@switchback/handoff": "workspace:*",
    "@switchback/host": "workspace:*",
    "@switchback/journal": "workspace:*",
    "@switchback/link": "workspace:*",
    "@switchback/protocol": "workspace:*",
    "@switchback/store": "workspace:*",
    "@switchback/wire": "workspace:*",
    "@switchback/worksite": "workspace:*",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.8.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1"
  }
}
