{
  "name": "@omni/desktop",
  "productName": "omni",
  "omni": {
    "_updateFeed": "发布时填一个 https 地址，返回 {version,url,notes}。留空 = 更新检查整个关闭，不发任何请求。",
    "updateFeed": "",
    "build": "8fb9e98-dirty"
  },
  "version": "0.0.101",
  "private": true,
  "type": "module",
  "description": "omni 桌面端：Electron 壳 + React 渲染层",
  "author": "wzj",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "//dist": "默认**关掉钥匙串自动发现**。不关的话 electron-builder 会拿钥匙串里任何一张证书去签——本机那张自签的会让 codesign 卡在逐个文件签名上（实测卡死，要手动 kill）。要签名走 dist:signed。",
    "dist": "node ../../scripts/stamp-version.mjs && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "//dist:signed": "有 Developer ID 时用。需要 CSC_NAME 或 CSC_LINK，公证还要 APPLE_ID / APPLE_APP_SPECIFIC_PASSWORD / APPLE_TEAM_ID。",
    "dist:signed": "node ../../scripts/stamp-version.mjs && electron-vite build && electron-builder --mac"
  },
  "//optionalDependencies": [
    "Claude Agent SDK 各平台的原生二进制。**必须在这里显式列出**——",
    "它们是 SDK 自己的 optionalDependencies，而 pnpm 10+ 不会替别的平台装传递依赖。",
    "实测在 macOS 上打 Linux 包时 electron-builder 直接警告它们没被打进产物，",
    "也就是说那个包里的 Claude 引擎根本起不来。",
    "每个包都带 os/cpu 字段，所以本机只会装 darwin-arm64 那一个，不占地方；",
    "Linux / Windows 的产物必须在对应平台上打，才装得到对应的那个。"
  ],
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.231",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.231",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.231",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.231",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.231",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.231"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.231",
    "@omni/approval": "workspace:*",
    "@omni/engine": "workspace:*",
    "@omni/handoff": "workspace:*",
    "@omni/host": "workspace:*",
    "@omni/journal": "workspace:*",
    "@omni/protocol": "workspace:*",
    "@omni/store": "workspace:*",
    "@omni/worksite": "workspace:*",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1"
  }
}
