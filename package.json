{
  "name": "omni",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "omni · 同文 —— 一个界面，统一驱动各家原生 coding agent",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run arch && pnpm run check:tokens && pnpm run check:css && pnpm run check:docs && pnpm run test",
    "typecheck": "tsc --build && tsc -p apps/desktop/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "arch": "node scripts/check-arch.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @omni/desktop dev",
    "dev:web": "pnpm --filter @omni/web dev",
    "build:web": "pnpm --filter @omni/web build",
    "harness:web": "node --import jiti/register apps/desktop/harness/web.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check:docs": "node scripts/check-changelog.mjs",
    "dist": "pnpm --filter @omni/desktop dist",
    "dist:signed": "pnpm --filter @omni/desktop dist:signed",
    "图标": "node scripts/make-icon.mjs",
    "check:css": "node scripts/check-css.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  }
}
